# Copy to the ignored supabase/functions/.env.local for local testing.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
RATE_LIMIT_SALT=replace-with-a-long-random-value
GEMINI_API_KEY=replace-locally-never-commit
GEMINI_MODEL=choose-an-available-model-id
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by the Edge runtime.
